# Copier ce fichier en .env et remplir (le .env n'est jamais commité).

# Azure AI Foundry — déploiement Mistral (ex. Mistral-Large-2411), région UE.
# Endpoint "OpenAI v1" de la ressource Foundry, par exemple :
#   https://<ressource>.services.ai.azure.com/openai/v1/
AZURE_AI_ENDPOINT=
AZURE_AI_KEY=
# Nom du déploiement dans Foundry
AZURE_AI_MODEL=Mistral-Large-2411
# Uniquement si l'endpoint est de type ".../models" (Azure AI Model Inference) :
# AZURE_AI_API_VERSION=2024-05-01-preview

# "demo" = n'appelle jamais le LLM : utilise le cache des fiches déjà générées
# (secours pour le pitch si le réseau tombe).
MAGISTRIA_MODE=
